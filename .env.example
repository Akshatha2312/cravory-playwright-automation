# =============================================================================
# Cravory Playwright Automation - Environment Variables Template
# Copy this file to '.env' for local test executions.
# DO NOT commit real passwords, secrets, or API keys to version control.
# =============================================================================

# Application Base URLs
BASE_URL=https://cravory-beta.vercel.app
API_URL=https://cravory-mern-ecommerce.onrender.com

# Playwright Test Execution Options
HEADLESS=true
TEST_TIMEOUT=30000

# Test Accounts (Placeholders for upcoming phases)
TEST_CUSTOMER_EMAIL=customer_test@example.com
TEST_CUSTOMER_PASSWORD=CustomerTestPass123!

TEST_VENDOR_EMAIL=vendor_test@example.com
TEST_VENDOR_PASSWORD=VendorTestPass123!

TEST_ADMIN_EMAIL=admin_test@example.com
TEST_ADMIN_PASSWORD=AdminTestPass123!
